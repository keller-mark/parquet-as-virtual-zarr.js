{
  "name": "parquet-as-virtual-zarr",
  "version": "0.2.1",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./bundled": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/bundled/index.js"
    },
    "./bundled-dynamic": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/bundled-dynamic/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build && vite build --mode bundled-dynamic",
    "generate-fixtures": "uv run fixtures/generate_fixtures.py",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config vite.config.demo.js",
    "build:demo": "vite build --config vite.config.demo.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@uwdata/flechette": "^2.3.0",
    "@zarrita/storage": "^0.2.0",
    "d3-dsv": "^3.0.1",
    "hyparquet": "^1.25.1",
    "numcodecs": "^0.3.2",
    "zarrita": "^0.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^25.5.0",
    "anndata.js": "0.0.3",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "patchedDependencies": {
      "anndata.js@0.0.3": "patches/anndata.js@0.0.3.patch"
    }
  }
}
